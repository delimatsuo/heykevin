    "canonicalization": "RFC8785_JSON_Canonicalization_Scheme",
    "digest_algorithm": "sha256(canonical_private_parameter_allowlist)",
    "required_top_level_fields": [
      "allowlist_version",
      "inventory_session_id",
      "producing_phase",
      "producing_phase_ordinal",
      "source_sha",
      "v5_normative_contract_digest",
      "project_bindings",
      "parameters_by_placeholder"
    ],
    "exact_placeholder_keys": [
