      "EACH_EXACT_ALLOWLISTED_SERVICE_NAME",
      "EXACT_DETAILED_ASSET_TYPE_ALLOWLIST",
      "EACH_EXACT_SOURCE_DECLARED_CLOUD_RUN_SERVICE",
      "EXACT_DATABASE_NAME_RETURNED_BY_ALLOWLISTED_LIST",
      "EXACT_INSTANCE_NAME_RETURNED_BY_ALLOWLISTED_LIST",
      "EXACT_DENY_POLICY_NAME_RETURNED_BY_ALLOWLISTED_LIST",
      "EXACT_ENUMERATED_SERVICE_ACCOUNT",
      "EXACT_MATCHED_PREDEFINED_ROLE_NAME",
      "EXACT_MATCHED_ROLE_ID",
      "EXACT_PAB_POLICY_NAME_RETURNED_BY_ALLOWLISTED_LIST",
      "EACH_EXACT_ENUMERATED_CONSTRAINT",
      "EXACT_OWNER_BOUND_MEMBER_QUERY",
      "EXACT_OWNER_BOUND_EFFECTIVE_ACCESS_TUPLE",
      "EACH_EXACT_BOUND_PROJECT_FOLDER_OR_ORGANIZATION_SCOPE"
    ],
    "project_binding_fields": [
      "project_id",
      "project_number",
      "query_identity_ref",
      "local_configuration_digest",
      "immediate_parent_digest",
      "ancestry_digest"
    ],
    "parameter_entry_fields": [
      "project_id",
      "value"
    ],
    "effective_access_tuple_fields": [
      "project_id",
      "identity_ref",
      "principal",
      "fullResourceName",
      "permission"
    ],
    "rules": [
      "The private artifact contains exact raw values needed to resolve method placeholders; only its digest may enter a checked-in receipt.",
      "Phase 1 output contains exactly four project bindings and the source-static allowlists.",
      "Every later output monotonically carries forward prior values and adds only values authenticated by that phase's request receipts.",
      "Every ordinary placeholder entry is an exact project_id and value pair and resolution requires both fields to match the request target.",
      "Every effective access tuple binds project_id identity_ref principal fullResourceName and permission.",
      "Unknown extra keys duplicate canonical entries duplicate project bindings type mismatches or values over V4 resource caps make the artifact invalid.",
      "The verifier rejects an allowlist unless its digest equals both the authenticated predecessor receipt derived_parameter_allowlist_digest and the current envelope predecessor_parameter_allowlist_digest."
    ]
  },
  "predecessor_receipt_verification_contract": {
    "phase_one_predecessor": "GENESIS",
    "later_phase_required_inputs": [
      "current_phase_envelope",
      "authenticated_predecessor_phase_receipt",
      "trusted_predecessor_receipt_public_key",
      "private_predecessor_parameter_allowlist",
      "verification_time_ms",
      "phase_once_ledger_snapshot"
    ],
    "required_checks_before_dispatch": [
      "predecessor_receipt_signature_is_valid_under_the_bound_trusted_key",
      "sha256(canonical_signed_predecessor_receipt)_equals_current_envelope_predecessor_phase_receipt_digest",
      "predecessor_receipt_result_is_pass_with_zero_error_codes",
      "predecessor_receipt_inventory_session_id_equals_current_inventory_session_id",
      "predecessor_receipt_phase_ordinal_plus_one_equals_current_phase_ordinal",
      "predecessor_receipt_phase_matches_the_v4_phase_table",
      "predecessor_receipt_source_and_all_contract_digests_equal_the_current_envelope",
      "predecessor_receipt_completed_at_ms_is_not_before_issued_at_ms",
      "verification_time_ms_is_before_predecessor_receipt_expires_at_ms",
      "predecessor_receipt_cumulative_request_count_equals_current_cumulative_prior_request_count",
      "private_allowlist_session_phase_ordinal_source_and_contract_bindings_match_the_predecessor_receipt",
      "sha256(canonical_private_allowlist)_equals_predecessor_receipt_derived_parameter_allowlist_digest",
      "sha256(canonical_private_allowlist)_equals_current_envelope_predecessor_parameter_allowlist_digest",
      "the_predecessor_phase_once_ledger_entry_is_present_consumed_and_unique"
    ],
    "any_failed_check_action": "inventory_incomplete_abort_before_dispatch_no_fallback"
  },
  "manifest_relational_verification_contract": {
    "required_checks_before_owner_signature_and_again_before_dispatch": [
      "request_count_equals_manifest_length_and_phase_specific_exact_or_bounded_count",
      "request_index_equals_zero_based_manifest_position_for_every_entry",
      "request_id_equals_req_dash_plus_three_digit_zero_padded_position",
      "request_id_values_are_unique",
      "canonical_request_digest_values_are_unique",
      "request_set_digest_equals_sha256_of_the_ordered_canonical_manifest",
      "actual_ordered_manifest_equals_the_independently_derived_expected_ordered_manifest",
      "every_method_ref_matches_the_exact_composite_method_table",
      "every_placeholder_is_replaced_by_a_value_from_the_authenticated_private_predecessor_allowlist_or_the_exact_phase_one_source_binding",
      "no_left_brace_or_right_brace_remains_in_canonical_path_and_query",
      "target_project_id_project_number_identity_configuration_and_quota_project_match_the_exact_project_binding",
      "the_manifest_exactly_satisfies_the_phase_coverage_algorithm"
    ],
    "request_id_format": "req-%03d",
    "unresolved_placeholder_pattern": "\\{[A-Z][A-Z0-9_]*\\}",
    "any_failed_check_action": "inventory_incomplete_abort_before_owner_signature_or_dispatch_no_fallback"
  },
  "phase_coverage_algorithms": {
    "project_id_binding": {
      "predecessor_allowlist": "GENESIS",
      "expected_multiset": "one project_identity_get for each of the four exact source project IDs",
      "expected_count": 4
    },
    "project_number_binding": {
      "predecessor_allowlist": "authenticated_project_id_binding_output",
      "expected_multiset": "for each exact predecessor project binding one project_provenance_get one project_ancestry_get and one project_billing_get using its non_null_number",
      "expected_count": 12
    },
    "metadata_discovery": {
      "predecessor_allowlist": "authenticated_project_number_binding_output",
      "expected_multiset": "all forty_eight service checks every required project search and every unique bound ancestry scope within cap",
      "count_rule": "derived_exact_count_between_64_and_96"
    },
    "metadata_detail": {
      "predecessor_allowlist": "authenticated_metadata_discovery_output",
      "expected_multiset": "every allowlisted discovered Firestore database and RTDB instance plus both source-declared Cloud Run services",
      "count_rule": "derived_exact_count_between_2_and_32"
    },
    "access_control_discovery": {
      "predecessor_allowlist": "authenticated_metadata_detail_output",
      "expected_multiset": "every required project ancestor resource and owner-bound-member discovery query within cap",
      "count_rule": "derived_exact_count_between_4_and_64"
    },
    "access_control_detail": {
      "predecessor_allowlist": "authenticated_access_control_discovery_output",
      "expected_multiset": "all eighty_eight static tuples and every allowlisted discovered policy role account PAB constraint secret KMS and dynamic tuple within caps",
      "count_rule": "derived_exact_count_between_88_and_384"
    },
    "actual_manifest_equality": "byte_for_byte_equality_after_RFC8785_canonicalization_of_each_ordered_entry",
    "omission_duplicate_extra_reorder_or_cap_failure": "inventory_incomplete"
  },
