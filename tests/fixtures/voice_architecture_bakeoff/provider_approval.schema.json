{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Voice Bakeoff Provider Approval Envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approval_id": {"type": "string"},
    "nonce": {"type": "string"},
    "issued_at_ms": {"type": "integer"},
    "expires_at_ms": {"type": "integer"},
    "self_digest": {"type": "string"},
    "environment": {"const": "bakeoff"},
    "arm": {"enum": ["A", "B1", "B2", "C"]},
    "source_sha": {"type": "string"},
    "manifest_digest": {"type": "string"},
    "dependency_inventory_digest": {"type": "string"},
    "artifact_digests": {"type": "object"},
    "dependencies": {"type": "array"},
    "caps": {"type": "object"},
    "disabled_features": {"type": "object"},
    "custody_references": {"type": "object"},
    "trust_metadata": {"type": "object"},
    "signatures": {"type": "array"}
  },
  "required": [
    "approval_id",
    "nonce",
    "issued_at_ms",
    "expires_at_ms",
    "self_digest",
    "environment",
    "arm",
    "source_sha",
    "manifest_digest",
    "dependency_inventory_digest",
    "artifact_digests",
    "dependencies",
    "caps",
    "disabled_features",
    "custody_references",
    "trust_metadata",
    "signatures"
  ],
  "x-required-roles": ["staff", "security_privacy", "conversation_product"],
  "x-execution": "unsupported"
}
